# All optional. The demo runs with zero configuration:
# `npm run demo:first-run` just works against a local panel.
#
# Precedence: CLI flags > existing process environment > this file > defaults.
# The demo loads this file explicitly and does not implicitly load generic .env.

# Application URL (default: http://127.0.0.1:8080).
MCPANEL_DEMO_URL=http://127.0.0.1:8080

# Demo credentials. The demo creates this account itself on a fresh data
# directory (default username: admin).
MCPANEL_DEMO_USERNAME=admin
MCPANEL_DEMO_PASSWORD=mcpanel-demo-password

# Run headless (default: true); set false or use --headed to show Chromium.
MCPANEL_DEMO_HEADLESS=true

# Presentation pacing is the default. Set to false (or pass --fast) for
# test-suite-speed development runs.
MCPANEL_DEMO_SLOW=true

# Warm recording is the default. Cold mode is for uncached provisioning
# validation against a freshly prepared panel data directory.
MCPANEL_DEMO_COLD=false

# High-quality browser screencast recording (1-100; default: 95).
MCPANEL_DEMO_VIDEO_QUALITY=95

# Force imperceptible recording-only browser paints during long idle waits.
MCPANEL_DEMO_CAPTURE_HEARTBEAT=true

# Correctness limits; presentation pauses are independent from these values.
MCPANEL_DEMO_UI_TIMEOUT_MS=30000
MCPANEL_DEMO_CATALOG_TIMEOUT_MS=90000
MCPANEL_DEMO_CREATE_SERVER_TIMEOUT_MS=60000
MCPANEL_DEMO_START_TIMEOUT_MS=60000
MCPANEL_DEMO_ONLINE_TIMEOUT_MS=1200000
