# All optional. The demo runs with zero configuration:
# `npm run demo:first-run` just works against a local panel.
#
# Precedence: CLI flags > these variables > built-in defaults.

# Application URL (default: http://127.0.0.1:8080).
MCPANEL_DEMO_URL=http://127.0.0.1:8080

# Demo credentials. The demo creates this account itself on a fresh data
# directory (default username: admin).
MCPANEL_DEMO_USERNAME=admin
MCPANEL_DEMO_PASSWORD=mcpanel-demo-password

# Show the browser instead of running headless (default: true).
MCPANEL_DEMO_HEADLESS=true

# Presentation pacing is the default. Set to false (or pass --fast) for
# test-suite-speed development runs.
MCPANEL_DEMO_SLOW=true
